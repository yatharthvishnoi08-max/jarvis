# Environment variables & secrets (CRITICAL: Never commit API keys)
.env

# Virtual Environment
.venv/
venv/
ENV/

# Python Cache & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so

# Audio cache files
audio_cache/
*.mp3
*.wav

# OS / Editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
.pytest_cache/

# Frontend build & dependencies
frontend/node_modules/
frontend/dist/
web_dist/

# Runtime session data & audit logs
memory/sessions/*.json
memory/traces/
memory/audit.jsonl
memory/webview_profile/
memory/screenshots/

# TLS Certificates & Private Keys
certs/
*.key
*.csr
*.srl

# Persistent SQLite Planner
memory/planner.sqlite3*

