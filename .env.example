# ==========================================
# JARVIS Core Credentials & Configuration
# ==========================================

# Owner Authentication Token (Used for Web UI and REST/WebSocket API)
JARVIS_AUTH_TOKEN=your_secure_random_token_here

# LLM Provider Selection: "gemini" or "openrouter" or "ollama"
LLM_PROVIDER=gemini

# Google Gemini API Key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter API Key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Model Selection:
# For Gemini: gemini-3.6-flash, gemini-3.5-flash, gemini-3.1-pro-preview
# For OpenRouter: meta-llama/llama-3.3-70b-instruct, nousresearch/hermes-3-llama-3.1-70b
MODEL_NAME=gemini-3.6-flash

# Base URL:
# For Gemini: https://generativelanguage.googleapis.com/v1beta/openai/
# For OpenRouter: https://openrouter.ai/api/v1
# For local Ollama: http://localhost:11434/v1
API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# ElevenLabs Voice Configuration (TTS)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# Wispr Flow Speech-to-Text (STT) (https://platform.wisprflow.ai)
WISPR_FLOW_API_KEY=your_wispr_flow_api_key_here

# Optional: Custom Allowed CORS Origins (comma separated)
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173
