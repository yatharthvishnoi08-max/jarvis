# ==========================================
# JARVIS Core Credentials & Configuration
# ==========================================

# Owner Authentication Token (Used for Web UI and REST/WebSocket API)
JARVIS_AUTH_TOKEN=your_secure_random_token_here

# OpenRouter API Key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Model Selection:
# meta-llama/llama-3.3-70b-instruct or nousresearch/hermes-4-405b
MODEL_NAME=meta-llama/llama-3.3-70b-instruct

# Base URL (OpenRouter or local Ollama: http://localhost:11434/v1)
API_BASE_URL=https://openrouter.ai/api/v1

# ElevenLabs Voice Configuration (TTS)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# Wispr Flow Speech-to-Text (STT) (https://platform.wisprflow.ai)
WISPR_FLOW_API_KEY=your_wispr_flow_api_key_here

# Optional: Custom Allowed CORS Origins (comma separated)
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173
